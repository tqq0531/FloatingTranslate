.gradle/
local.properties
**/build/
*.jks
*.keystore
# Reproducible model weights: run tools/prepare_translation.py before building.
app/src/main/assets/translation/*.onnx
app/src/main/assets/translation/source.spm
app/src/main/assets/translation/vocab.json
app/src/main/assets/translation/sp-map.json

.model-venv/

# English-to-Chinese weights are generated from the pinned model source too.
app/src/main/assets/translation-en-zh/*.onnx
app/src/main/assets/translation-en-zh/source.spm
app/src/main/assets/translation-en-zh/vocab.json
app/src/main/assets/translation-en-zh/sp-map.json
